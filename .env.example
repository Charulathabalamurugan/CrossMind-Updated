# CrossMind Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SETTINGS_PROFILE=default

# API Security
API_KEY=
DASHBOARD_API_KEY=
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_SIZE_MB=10
MAX_QUERY_LENGTH=5000
MAX_DOC_CONTENT_LENGTH=50000
RATE_LIMIT_PER_MINUTE=1000

# ZAYA1-8B / RxG Nano Engine
ZAYA1_8B_MODEL_NAME=ZAYA1-8B
ZAYA1_8B_API_BASE=http://localhost:8000/v1
ZAYA1_8B_TEMPERATURE=0.2
ZAYA1_8B_MAX_TOKENS=4096
RXG_NANO_MODEL_NAME=OpceanAI/Yuuki-RxG-nano
RXG_NANO_API_BASE=http://localhost:8000/v1
RXG_NANO_TEMPERATURE=0.2
RXG_NANO_MAX_TOKENS=4096
USE_LOCAL_SIMULATOR_FALLBACK=True

# LLM / Model Serving
VLLM_ENABLED=False
VLLM_BATCH_SIZE=8
VLLM_MAX_NUM_SEQS=2
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=131072
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
LITELLM_ENABLED=True
LITELLM_MODEL_NAME=lite-llm/mini
MODEL_FALLBACK_CHAIN=vllm,simulator

# Ingestion / Embedding
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIM=256
MINERU_EXTRACTION_ENABLED=True
MINERU_API_BASE=http://localhost:8002
TIKA_FALLBACK_ENABLED=True
TIKA_SERVER_URL=http://localhost:9998
BGE_M3_ENABLED=True
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_DIM=1024
BGE_M3_RETRIEVAL_DIM=256
BGE_M3_MATRYOSHKA_ENABLED=True
BGE_M3_PRECISION=fp32
BGE_M3_MAX_LENGTH=8192
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Vector Store / Cache
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=True
QDRANT_COLLECTION_NAME=crossmind_knowledge
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUERY_CACHE_TTL=3600
REDIS_QUERY_CACHE_MAX=5000
REDIS_RETRIEVAL_CACHE_TTL=1800
REDIS_RETRIEVAL_CACHE_MAX=10000

# Knowledge Graph / Neo4j
NEO4J_ENABLED=False
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Reasoning / Orchestration
MULTI_AGENT_ENABLED=True
Z3_VALIDATION_ENABLED=True
DUAL_MEMORY_ENABLED=True
WFA_FAST_PATH_ENABLED=True
FAST_PATH_CONFIDENCE_THRESHOLD=0.85
DECISION_TREE_ENABLED=True
SCALLOP_ENABLED=False
SEMARA_ENABLED=True
SEMARA_IMPL=tech-mahindra
SEMARA_ONTOLOGY_URL=
DEFORESTVIS_ENABLED=False
DEFORESTVIS_PORT=8003
GRAPH_RAG_ENABLED=True
GRAPH_RAG_DEPTH=3
GRAPH_RAG_EARLY_STOP_THRESHOLD=0.75
GRAPH_RAG_MAX_PATHS=20
GRAPH_RAG_MIN_EVIDENCE=3

# Observability
OPENTELEMETRY_ENABLED=True
OPENTELEMETRY_EXPORTER=http://localhost:4317
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
STREAMLIT_DASHBOARD_ENABLED=True
REACT_UI_ENABLED=False
STREAMING_SSE_ENABLED=True
SSE_COMPRESSION_ENABLED=False

# Caching
HOT_CACHE_ENABLED=True
DISK_CACHE_ENABLED=True
DISK_CACHE_PATH=/tmp/crossmind_disk_cache
DLDB_ENABLED=True
DLDB_PATH=/var/lib/crossmind/dldb
DLDB_BACKUP_ENABLED=False
DLDB_MAX_SIZE_GB=10
DLDB_RETENTION_DAYS=90

# Storage / External Services
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ASYNC_INGESTION_ENABLED=False
CONTINUOUS_INGESTION_INTERVAL=300
INGESTION_BATCH_SIZE=50
INGESTION_MAX_RETRIES=3
PLUGIN_AUTO_DISCOVER_ENABLED=True
PLUGIN_DIRS=
DYNAMIC_CONNECTORS_ENABLED=True
DYNAMIC_CONNECTOR_SOURCES=file,api,webhook

# RBAC / Auth
RBAC_ENABLED=True
RBAC_ROLES=admin,analyst,viewer
RBAC_APP_ENABLED=True
DASHBOARD_AUTH_ENABLED=False
DASHBOARD_ALLOWED_ROLES=admin,researcher,viewer

# Request Handling
REQUEST_DEDUPLICATION_ENABLED=True
REQUEST_DEDUPLICATION_TTL_SECONDS=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
EXTERNAL_SERVICE_TIMEOUT_SECONDS=5.0
TOKEN_TRACKING_ENABLED=True
COST_PER_1K_TOKENS=0.0

# Schema
CACHE_SCHEMA_VERSION=1
DATA_SCHEMA_VERSION=1
VECTOR_SCHEMA_VERSION=1
KG_SCHEMA_VERSION=1
API_SCHEMA_VERSION=1

# Active Learning
ACTIVE_LEARNING_ENABLED=True
ACTIVE_LEARNING_MIN_FEEDBACK=10
ACTIVE_LEARNING_RETRAIN_INTERVAL=3600

# Cost / Risk
RISK_FEEDBACK_ENABLED=True
EXPERIMENTAL_BLUEPRINT_ENABLED=True
